# Clave privada de Gemini; cópiala a .env y nunca la incluyas en el código.
GOOGLE_API_KEY=
# Modelo de Gemini que se usará en el proyecto.
MODELO=gemini-3.5-flash-lite
# Dirección donde escuchará el agente de viajes.
URL_VIAJES=http://127.0.0.1:8000
# Dirección donde escuchará el agente de restaurantes.
URL_RESTAURANTES=http://127.0.0.1:8001
# Dirección donde escuchará el coordinador.
URL_COORDINADOR=http://127.0.0.1:8002
# Dirección donde escuchará el agente de Anggie.
URL_ANGGIE=http://127.0.0.1:8003
# Dirección donde escuchará el agente de Enrique.
URL_ENRIQUE=http://127.0.0.1:8004
# Dirección donde escuchará el agente de Gustavo.
URL_GUSTAVO=http://127.0.0.1:8005
URL_ALGOMARKET=http://127.0.0.1:8005
# Dirección donde escuchará el agente de Cristian.
URL_CHRISTIAN=http://127.0.0.1:8006

# Túnel que publican las fichas A2A de los agentes. Dejar VACÍA en local:
# si se llena, todos los agentes levantados con este .env publican esa dirección.
URL_PUBLICA=


#Enrique  = Cine
#Christian = Patio comida
#Gustavo = Supermercado
#Anggie = Tiendas de mall

# Agentes de mis compañeros (cambian cada vez que reinician su túnel)
TUNEL_ENRIQUE=https://thing-mem-reviews-realtor.trycloudflare.com
TUNEL_GUSTAVO=https://nashville-accidents-illustration-medical.trycloudflare.com
TUNEL_ANGGIE=https://sections-valuation-tue-delivers.trycloudflare.com/

# Catálogo del coordinador: mi agente + compañeros
#URLS_AGENTES=${TUNEL_ANGGIE},${TUNEL_ENRIQUE},${TUNEL_GUSTAVO}

# Catálogo del coordinador: mi agente + compañeros local
URLS_AGENTES=${URL_ANGGIE},${URL_ENRIQUE},${URL_ALGOMARKET},${URL_CHRISTIAN}
# Desactiva el trazado de CrewAI.
CREWAI_TRACING_ENABLED=false
# Clave de acceso a la API FASTAPI.
API_KEY=cambiame
# Puerto de la API FASTAPI.
API_PUERTO=8010
# Token del bot de Telegram.
TELEGRAM_TOKEN=
# Secreto de Telegram.
TELEGRAM_SECRET=cambiame
# URL pública de TELEGRAM.
PUBLIC_URL=

# Configuraci?n opcional usada por los agentes.
USAR_OAUTH=false
GOOGLE_CLOUD_PROJECT=proyecto-falso
GOOGLE_CLOUD_LOCATION=global
TIMEOUT_A2A=60
TIMEOUT_FICHA=10
MAX_PASOS_AGENTE=12
MAX_LARGO_PREGUNTA=2000
ZONA_HORARIA=America/Santiago
CANAL=web
AHORA=
