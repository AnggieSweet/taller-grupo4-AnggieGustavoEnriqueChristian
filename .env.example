# Clave privada de Gemini; cópiala a .env y nunca la incluyas en el código.
GOOGLE_API_KEY=
# Modelo de Gemini que se usará en el proyecto.
MODELO=gemini-3.5-flash-lite
# Dirección donde escuchará el agente de viajes.
URL_VIAJES=http://127.0.0.1:8000
# Dirección donde escuchará el agente de restaurantes.
URL_RESTAURANTES=http://127.0.0.1:8001
# Dirección donde escuchará el coordinador.
URL_COORDINADOR=http://127.0.0.1:8002
# Dirección donde escuchará el agente de Anggie.
URL_ANGGIE=http://127.0.0.1:8003
# Dirección donde escuchará el agente de Enrique.
URL_ENRIQUE=http://127.0.0.1:8004
# Dirección donde escuchará el agente de Gustavo (AlgoMarket).
URL_ALGOMARKET=http://127.0.0.1:8005
# Dirección donde escuchará el agente de Christian.
URL_CHRISTIAN=http://127.0.0.1:8006

# Túnel que publican las fichas A2A de los agentes. Dejar VACÍA en local:
# si se llena, todos los agentes levantados con este .env publican esa dirección.
URL_PUBLICA=

# Enrique  = Cine
# Christian = Patio de comidas
# Gustavo  = Supermercado AlgoMarket
# Anggie   = Tiendas del mall

# Ejemplo ficticio si se conectan agentes remotos de compañeros por túnel temporal
TUNEL_ENRIQUE=https://ejemplo-cine-ficticio.trycloudflare.com
TUNEL_GUSTAVO=https://ejemplo-supermercado-ficticio.trycloudflare.com
TUNEL_ANGGIE=https://ejemplo-tiendas-ficticio.trycloudflare.com

# Catálogo del coordinador local (además de URL_VIAJES y URL_RESTAURANTES)
URLS_AGENTES=${URL_ANGGIE},${URL_ENRIQUE},${URL_ALGOMARKET},${URL_CHRISTIAN}
# Desactiva el trazado externo de CrewAI.
CREWAI_TRACING_ENABLED=false
# Clave de acceso a la API FastAPI (genera una propia con secrets.token_urlsafe(32)).
API_KEY=clave_ejemplo_cambiame_no_usar_en_real
# Clave compartida que protege el endpoint A2A (POST /) de los 6 agentes; el coordinador la envía en X-API-Key.
# Vacía = agentes sin protección (solo aceptable en local). Obligatoria si se exponen por túnel o en la nube;
# todos los integrantes que conecten agentes entre sí deben usar el mismo valor.
AGENT_API_KEY=
# Host y puerto configurables de la API FastAPI (o variable estándar PORT en PaaS).
API_HOST=127.0.0.1
API_PUERTO=8010
# Token del bot de Telegram (@BotFather).
TELEGRAM_TOKEN=
# Secreto del webhook de Telegram (X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_SECRET=secreto_ejemplo_cambiame_no_usar_en_real
# Lista de chat_id de Telegram autorizados, separados por comas.
TELEGRAM_PERMITIDOS=

# Configuración alternativa con Google Cloud OAuth / ADC (opcional).
USAR_OAUTH=false
GOOGLE_CLOUD_PROJECT=proyecto-ejemplo-ficticio
GOOGLE_CLOUD_LOCATION=global
TIMEOUT_A2A=60
TIMEOUT_FICHA=10
MAX_PASOS_AGENTE=12
MAX_LARGO_PREGUNTA=2000
ZONA_HORARIA=America/Santiago
CANAL=web
AHORA=
